# ==============================================================================
# DASHBOARD DE FACTURACIONES Y NÓMINAS — VARIABLES DE ENTORNO
# Copiar este archivo a .env y configurar con credenciales reales en producción.
# NUNCA subir el archivo .env real al repositorio.
# ==============================================================================

# ENTORNO Y SERVIDOR
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_URL=https://carplamor25-svg.github.io/Dashboard-De-facturaciones-Proyecto/
API_URL=https://api.midominio.com

# BASE DE DATOS POSTGRESQL CON ROW-LEVEL SECURITY (RLS)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dashboard_facturas_prod
DB_USER=facturas_app_user
DB_PASSWORD=CAMBIAR_POR_PASSWORD_ROBUSTO_32_CARACTERES_MINIMO
DB_SSL=false
DB_MAX_CONNECTIONS=20

# SEGURIDAD Y SESIONES (JWT / COOKIES HTTPONLY)
JWT_SECRET=GENERAR_SECRET_HEX_64_BYTES_PARA_FIRMA_DE_SESION_HTTPONLY
JWT_EXPIRES_IN=2h
COOKIE_SECRET=GENERAR_SECRET_HEX_64_BYTES_PARA_CIFRADO_DE_COOKIES
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict

# SEGUNDO FACTOR DE AUTENTICACIÓN (2FA TOTP RFC 6238)
TOTP_SERVICE_NAME=DashboardFacturas
TOTP_WINDOW=1

# CLOUDFLARE TURNSTILE (CAPTCHA EN SERVIDOR)
TURNSTILE_SITE_KEY=0x4AAAAAAABBBBBCCCCCDDDD
TURNSTILE_SECRET_KEY=0x4AAAAAAABBBBBCCCCCDDDD_SECRET_KEY
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# COLA ASÍNCRONA DE TAREAS (Redis / BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR_POR_PASSWORD_REDIS_SEGURO

# PROCESAMIENTO CON IA LOCAL (OLLAMA POR CLOUDFLARE TUNNEL)
OLLAMA_API_BASE_URL=https://ollama-tunnel.midominio.com
OLLAMA_MODEL=gemma2:9b-instruct-q4_K_M
CF_ACCESS_CLIENT_ID=CLOUDFLARE_ACCESS_SERVICE_TOKEN_CLIENT_ID
CF_ACCESS_CLIENT_SECRET=CLOUDFLARE_ACCESS_SERVICE_TOKEN_CLIENT_SECRET

# BOT DE TELEGRAM (ASISTENTE FISCAL INTELIGENTE)
TELEGRAM_BOT_TOKEN=TOKEN_BOT_TELEGRAM_GENERADO_CON_BOTFATHER
TELEGRAM_WEBHOOK_URL=https://api.midominio.com/api/v1/telegram/webhook

# CORREO TRANSACCIONAL AUTOMATIZADO (SMTP / EMAILJS)
SMTP_HOST=smtp.midominio.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=facturas@midominio.com
SMTP_PASSWORD=PASSWORD_SMTP_TRANSACCIONAL
EMAIL_FROM="Dashboard Facturas <facturas@midominio.com>"

# ALMACENAMIENTO EFÍMERO Y DESTRUCCIÓN CRIPTOGRÁFICA
TEMP_STORAGE_PATH=/var/app/temp_uploads
AUTO_SHRED_AFTER_DELIVERY=true
SHRED_RETRIES=3
MAX_RETENTION_HOURS=24
COLUMN_ENCRYPTION_KEY=64_CARACTERES_HEX_CLAVE_MAESTRA_AES_256_GCM
